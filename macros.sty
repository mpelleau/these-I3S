%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Bibliography
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\usepackage{csquotes}
\usepackage[style=apa]{biblatex}

\addbibresource{biblio.bib}

\DeclareBibliographyCategory{mine}
\DeclareBibliographyCategory{web}
\def\citeweb#1{
  \cite{#1}
  \addtocategory{web}{#1}
}
\def\citemine#1{
  \cite{#1}
  \addtocategory{mine}{#1}
}

\defbibheading{minestyle}[Mes publications]{%
  \section*{#1}%
  \markright{#1}}

\defbibheading{webstyle}[Pages web]{%
  \section*{#1}%
  \markright{#1}}

